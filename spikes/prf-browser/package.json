{
  "name": "prf-browser-spike",
  "private": true,
  "type": "module",
  "description": "Day-1 spike: real WebAuthn PRF in a browser → Letterlock key; optional P256 binding checked against Monad's 0x0100 precompile",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --test \"test/*.test.ts\"",
    "test": "node --test \"test/*.test.ts\" && node run-spike.mjs",
    "check:page": "node check-page.mjs"
  },
  "dependencies": {
    "letterlock": "workspace:*",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@category-labs/mera": "0.2.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "1.5.6",
    "jsqr": "1.4.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
