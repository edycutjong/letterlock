  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.ts",
    "call": "node scripts/call.ts",
    "testnet": "node scripts/testnet-run.ts",
    "publish-agent-key": "node scripts/publish-agent-key.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "letterlock": "workspace:*",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
