{
  "name": "letterlock-demo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edycutjong/letterlock.git",
    "directory": "apps/demo"
  },
  "homepage": "https://letterlock-app.vercel.app",
  "type": "module",
  "description": "Letterlock app: the postal-register design system and the five routes, live on Monad mainnet (a testnet build for the end-to-end tests), with the gas drip for a first publish and the /kit gallery.",
  "scripts": {
    "dev": "next dev -p 3217",
    "build": "next build",
    "start": "next start -p 3217",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "qa": "node scripts/qa.mjs",
    "e2e": "node --test-reporter=spec scripts/e2e.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "letterlock": "workspace:*",
    "next": "15.5.26",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0"
  }
}
